# LangGraph Agent configuration. Copy to `.env` and adjust if needed.

# AWS (local dev: the named profile; on EC2: instance role, leave AWS_PROFILE unset)
AWS_PROFILE=course
AWS_REGION=us-east-1

# Gemini (key is pulled from AWS Secrets Manager — never set the key itself here)
GEMINI_SECRET_NAME=property-triage/gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Sibling services the agent calls as tools (localhost for dev; private IPs on EC2)
RAG_URL=http://127.0.0.1:8001
IMAGE_URL=http://127.0.0.1:8002

# RAG service configuration. Copy to `.env` and adjust if needed.

# AWS (local dev: the named profile; on EC2: instance role, leave AWS_PROFILE unset)
AWS_PROFILE=course
AWS_REGION=us-east-1

# Bedrock Knowledge Base (created by scripts/03_create_kb.py on 2026-06-10)

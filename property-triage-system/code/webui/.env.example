# WebUI configuration. Copy to `.env` and adjust. All values have safe defaults.

# Local Ollama server (used by the Assistant tab)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# n8n webhook for the Submit Listing tab.
# Leave EMPTY to run in MOCK mode (returns a sample brief, no n8n needed).
# Set to the real webhook URL once the n8n flow exists (Phase 4).
N8N_WEBHOOK_URL=
